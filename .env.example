# ── Supabase ─────────────────────────────────────────────
# Create a project at https://supabase.com, then Project Settings → API.
# Leave blank to run the site in DEMO MODE (bundled catalog, simulated checkout).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (Project Settings → API → service_role). REQUIRED in live
# mode for service-only commerce/newsletter writes, guest access, payments,
# uploads, and scheduled jobs. Server-only — never expose it to the browser.
# Leave blank only when intentionally running the bundled demo mode.
SUPABASE_SERVICE_ROLE_KEY=

# ── Razorpay ─────────────────────────────────────────────
# From https://dashboard.razorpay.com → Account & Settings → API Keys.
# Key ID is public (used by the checkout widget); the secret stays server-side.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret (Dashboard → Webhooks → create endpoint
# https://your-domain.com/api/razorpay/webhook, events: payment.captured,
# payment.failed). Enables reliable server-side payment reconciliation.
RAZORPAY_WEBHOOK_SECRET=

# ── Transactional email (Resend) ─────────────────────────
# https://resend.com → API Keys. Leave blank to skip emails silently.
RESEND_API_KEY=
# Verified sender, e.g. "Fasteno <orders@fasteno.in>"
EMAIL_FROM=
# Where owner "new order" alerts go. Falls back to SUPPORT_EMAIL (lib/config.ts).
ORDER_NOTIFY_EMAIL=

# ── Shiprocket (shipping) ────────────────────────────────
# API user from https://app.shiprocket.in → Settings → API → Configure.
# IMPORTANT: create a dedicated API user there — it is NOT your dashboard
# login. Leave blank to keep entering courier/AWB by hand; every Shiprocket
# feature stays dormant and the store works exactly as before.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Pickup address nickname exactly as named in Settings → Pickup Addresses.
SHIPROCKET_PICKUP_LOCATION=Primary
# Origin pincode — required for the product-page serviceability check.
SHIPROCKET_PICKUP_PINCODE=
# Parcel defaults (Shiprocket bills on volumetric weight; set these to a
# real packed parcel or you will be re-billed on reconciliation).
SHIPROCKET_PARCEL_WEIGHT_KG=0.3
SHIPROCKET_PARCEL_LENGTH_CM=22
SHIPROCKET_PARCEL_BREADTH_CM=16
SHIPROCKET_PARCEL_HEIGHT_CM=4
# Set to 1 to book a courier automatically the moment payment is confirmed.
# Off by default — most sellers want to pack and weigh before booking.
SHIPROCKET_AUTO_SHIP=

# ── Scheduled jobs ───────────────────────────────────────
# Shared secret for /api/cron/reap-orders and /api/cron/sync-shipments. Set
# the SAME high-entropy value in the Vercel project env; Vercel Cron sends it
# as `Authorization: Bearer <secret>`. Both routes return 503 while it is unset.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Controlled maintenance window ─────────────────────────
# Server-only deployment gate. Exact value 1 blocks ordinary traffic across
# every hostname before app/auth/database code. Unset or 0 disables the gate.
MAINTENANCE_MODE=
# Optional operator unlock: exactly 32 random bytes encoded as 64 hex chars.
# The raw value is accepted only by POST and is never stored in the browser.
# Do not reuse CRON_SECRET, payment secrets, public keys, or passwords.
# Generate with: openssl rand -hex 32
MAINTENANCE_BYPASS_SECRET=
# Keep unset/0 while migration 006 is missing so Razorpay receives retryable
# maintenance responses. Set to 1 only after the payment RPCs exist and while
# signed webhook processing should continue through an active maintenance gate.
MAINTENANCE_ALLOW_RAZORPAY_WEBHOOK=

# ── Rate limiting (required for strict production endpoints) ──
# Upstash Redis REST credentials (https://console.upstash.com → your DB →
# REST API). Set BOTH values in production. Guest-link exchange, Razorpay
# verification, newsletter, order tracking, and admin upload return 503 when
# their strict distributed limiter is missing or unavailable. Development and
# availability-mode callers retain the bounded per-instance memory fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set an independent high-entropy HMAC secret for anonymizing limiter targets.
# Use at least 32 random bytes; do not reuse a public key or human password.
# Generate with: openssl rand -hex 32
RATE_LIMIT_HASH_SECRET=

# ── Approved image sources ───────────────────────────────
# Comma-separated exact DNS hostnames only: no schemes, paths, ports, leading
# dots, or wildcards. A valid HTTPS NEXT_PUBLIC_SUPABASE_URL host is automatic.
# These hosts also generate CSP img-src at deployment time, so audit all
# persisted image origins and rebuild/redeploy after changing this value.
ALLOWED_IMAGE_HOSTS=

# ── Analytics ────────────────────────────────────────────
# GA4 measurement id (G-XXXXXXXXXX). Leave blank to disable.
NEXT_PUBLIC_GA_ID=
# Privacy gate: set true only after GA4 Enhanced Measurement and all other
# automatically collected web-stream events are disabled in the GA dashboard.
# Without this exact acknowledgement, the browser analytics tag is not loaded.
NEXT_PUBLIC_GA_EXPLICIT_EVENTS_ONLY=

# ── Google login ─────────────────────────────────────────
# Set to 1 ONLY after enabling the Google provider in Supabase
# (Authentication → Providers → Google, with a Google Cloud OAuth client
# whose redirect URI is https://<project-ref>.supabase.co/auth/v1/callback).
# While unset, the "Continue with Google" button is hidden.
NEXT_PUBLIC_GOOGLE_LOGIN=

# ── Site ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
